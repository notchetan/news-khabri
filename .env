# EXPO_PUBLIC_* vars are inlined into the client bundle at build time and
# are not secret - see docs/google-sign-in.md. This is committed on
# purpose (matches Expo's own .env vs. .env.local convention in
# .gitignore), unlike the backend's JWT_SECRET.

# The same Google Cloud Console "Web application" OAuth client ID the
# backend's GOOGLE_WEB_CLIENT_ID must match exactly - see the backend's
# docs/google-sign-in.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=769632986362-nno5rlm49f7qtdjfa0oubvijch8t1o89.apps.googleusercontent.com
