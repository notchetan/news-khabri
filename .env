# EXPO_PUBLIC_* vars are inlined into the client bundle at build time and
# are not secret - see docs/google-sign-in.md. This is committed on
# purpose (matches Expo's own .env vs. .env.local convention in
# .gitignore), unlike the backend's JWT_SECRET.

# The same Google Cloud Console "Web application" OAuth client ID the
# backend's GOOGLE_WEB_CLIENT_ID must match exactly - see the backend's
# docs/google-sign-in.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=769632986362-nno5rlm49f7qtdjfa0oubvijch8t1o89.apps.googleusercontent.com

# Backend API base URL. This committed value is the local-dev default
# (iOS simulator + `expo start` on the same machine). Override it - never
# edit this line - in an untracked .env.local:
#   Android emulator:  EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#   physical device:   EXPO_PUBLIC_API_URL=http://<your-LAN-IP>:3000
# Release builds set it per EAS build profile (must be https).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Sentry crash/error reporting DSN. A DSN is a write-only ingest key, not
# a secret - safe to commit. Empty here on purpose: leaving it unset keeps
# Sentry fully inert (no init, no network) - see src/observability/sentry.ts.
# Set a real value per environment (EAS build profile / .env.local). The
# source-map upload credentials (SENTRY_ORG, SENTRY_PROJECT,
# SENTRY_AUTH_TOKEN) are build-time only, are NOT EXPO_PUBLIC_, and belong
# in EAS secrets - never here. Sentry also stays off in __DEV__ regardless.
EXPO_PUBLIC_SENTRY_DSN=
