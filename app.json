{
  "expo": {
    "name": "News Khabri",
    "slug": "news-khabri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "newskhabri",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon-ios.png",
      "bundleIdentifier": "com.newskhabri.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.newskhabri.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#17140F"
          }
        }
      ],
      "expo-asset",
      [
        "./plugins/with-android-root-view-background.js",
        {
          "light": "#FAF7F2",
          "dark": "#17140F"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "685e0278-f360-4526-bd84-8a945e996225"
      }
    }
  }
}
